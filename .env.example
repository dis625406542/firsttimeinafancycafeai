# No secrets in this file. Example only.
NEXT_PUBLIC_SITE_URL=https://firsttimeinafancycafeai.org
GOOGLE_SITE_VERIFICATION=
# GA4 measurement ID (public, e.g. G-XXXXXXXXXX). Leave empty to disable analytics.
NEXT_PUBLIC_GA_ID=
# Cafe checkout stays closed until reference, authorized audio and delivery are verified.
FANCY_CAFE_CHECKOUT_ENABLED=false
FANCY_CAFE_ASSETS_APPROVED=false
# Upload reviewed, authorized 15-second cafe assets to these PRIVATE R2 keys before opting in.
FANCY_CAFE_REFERENCE_KEY=fancy-cafe-ai/v1/reference-first15-silent.mp4
FANCY_CAFE_AUDIO_KEY=fancy-cafe-ai/v1/soundtrack-first15.mp3

# Server-side paid video generation; enable only after Stripe, database, R2, provider and worker are configured.
# Required server-side image safety gate (Anthropic-compatible VISION model).
# Model must support up to three base64 images per request with thinking disabled.
# Portraits are moderated in batches; failures block video submission.
ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic
ANTHROPIC_AUTH_TOKEN=replace_with_your_vision_api_key
ANTHROPIC_MODEL=deepseek-flash

VIDEO_GENERATION_ENABLED=false
# Local dev only: simulate checkout, but generate real paid-provider videos.
# Ignored in production, Vercel, CI and non-loopback requests; keep false outside local testing.
LOCAL_MOCK_PAYMENTS=false
# Switch providers without touching code: poyo (default) or yir.
VIDEO_PROVIDER=yir
# Required for YIR and for signed task links to survive switching providers/restarts.
VIDEO_HANDLE_SECRET=replace_with_a_long_random_secret_at_least_32_chars

# YIR: server-side API key. Requests omit max_cost; actual provider charges apply.
YIR_API_KEY=replace_with_your_yir_key
# Fancy Cafe v1 pins Seedance 2.5: one or two ordered portraits + silent reference, 15s, 480p/720p.
# Both quote and submit force generate_audio=false; unsupported silence stops submission.
YIR_MODEL_ID=bytedance/seedance-2.5
# Set only if your model contract declares subject_references (named @Image1/@Image2).
# YIR_REFERENCE_SUBJECTS=true

# Keep this key if you want to switch back or poll an unfinished PoYo task.
# poyo_seedance_token=replace_with_your_poyo_key


# PostgreSQL. DATABASE_PRO_NAME selects the runtime schema; the URL's schema= must match it.
# Runtime SQL uses a {schema}. marker and validates this site-specific schema.
# This website accepts only firsttimeinafancycafeai_pro, to prevent copied credentials writing to the old site.
# Run npm run db:migrate (schema-only; no old products or prices copied). Keep SSL configured.
DATABASE_PRO_URL=postgresql://user:password@host:5432/postgres?sslmode=verify-full&schema=firsttimeinafancycafeai_pro
DATABASE_PRO_NAME=firsttimeinafancycafeai_pro

# Same-site Node FFmpeg composition (no separate composition service).
# Optional absolute executable paths; leave blank to use the packaged platform binaries.
# Both binaries, libx264/AAC, writable OS temp space and a 300s route budget are required.
FFMPEG_PATH=
FFPROBE_PATH=

# Private Cloudflare R2 assets and finished videos (server-side only; NEVER use NEXT_PUBLIC_).
# Create an R2 S3 API token restricted to this bucket with Object Read & Write.
# for this demo; Object Read & Write also works if reused for later ingestion.
# Use Access Key ID + Secret Access Key, NOT the Cloudflare management API token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
# Leave unset for global buckets; set us/eu/fedramp for jurisdictional buckets.
R2_JURISDICTION=us
R2_DEMO_VIDEO_KEY=demo1.mp4

# Comma-separated EXACT trusted provider result-media hostnames (no scheme/path).
# Required to download provider results for archival/composition.
# Fancy Cafe v1 never delivers the silent raw provider result as a finished video.
# Inspect an actual provider result URL server-side and add its hostname here before testing.
# Do NOT allow *.r2.cloudflarestorage.com; use the exact provider media account host.
PROVIDER_VIDEO_HOSTS=

# One-time, hosted Stripe checkout. False or placeholder keys disable checkout.
STRIPE_ENABLED=false
# Standard (sk_test_/sk_live_) and restricted (rk_test_/rk_live_) keys are supported.
# Restricted keys need permission to read Products/Prices and create/read Checkout Sessions.
# Never expose this key to the browser.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Portal configuration is NOT required: no subscriptions or customer account portal.
# STRIPE_PORTAL_CONFIGURATION_ID=
# Background reconciliation requires a separate cron invocation, not just web requests.
CRON_SECRET=replace_with_a_separate_random_secret_at_least_32_chars
VIDEO_DAILY_SUBMISSION_LIMIT=20
# Optional direct migration URL when application DATABASE_PRO_URL uses pooling.
# DIRECT_PRO_URL=

# Development only: comma-separated exact tunnel hostnames, without scheme/path.
# Update when restarting a temporary Cloudflare tunnel; restart Next after changes.
DEV_ALLOWED_ORIGINS=

# Optional delivery emails (verified sender domain required). If unset, checkout works without email.
RESEND_API_KEY=
VIDEO_EMAIL_FROM=
